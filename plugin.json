{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "aicq",
  "version": "0.1.0",
  "description": "Link a Fulcra account and establish a portable AICQ agent address.",
  "repository": "https://github.com/kubla/aicq",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/onboarding/SKILL.md",
